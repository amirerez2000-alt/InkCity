# תבנית משתני סביבה — העתק ל-.env ומלא ערכים אמיתיים.
# הקובץ .env אינו בגיט (ראו .gitignore).

# --- אבטחה ---
# חובה בייצור. יצור עם:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-here

# False בייצור. True רק בפיתוח מקומי.
DEBUG=True

# רשימת דומיינים מופרדים בפסיקים.
ALLOWED_HOSTS=localhost,127.0.0.1

# מקורות מהימנים ל-CSRF (חובה מאחורי proxy).
# CSRF_TRUSTED_ORIGINS=https://inkcity.example.com

# --- מסד נתונים ---
# DATABASE_URL=postgres://user:pass@localhost:5432/inkcity

# --- דואר ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=InkCity <noreply@inkcity.com>

# --- מטמון ---
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# CACHE_LOCATION=inkcity-default
# CACHE_TIMEOUT=300

# --- אבטחת יישום ---
# הגבלת קצב (True/False)
RATELIMIT_ENABLE=True
AXES_ENABLED=False
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=30

# --- אימות מייל ---
MAX_VERIFICATION_ATTEMPTS=5
VERIFICATION_CODE_TTL_MINUTES=15

# --- יומנים ---
LOG_LEVEL=INFO
BOOKS_LOG_LEVEL=INFO
# LOG_FILE=logs/inkcity.log

# --- HTTPS (ייצור) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO
